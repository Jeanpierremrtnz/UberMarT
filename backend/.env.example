# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Genera los secretos con: npm run gen:secrets

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.tudominio.ec
APP_DEEP_LINK=ubermart://
TRUST_PROXY=1

# Usuario con permisos mínimos (la API). Las migraciones usan otro usuario.
DATABASE_URL=postgres://ubermart_app:CAMBIAR@db:5432/ubermart
MIGRATIONS_DATABASE_URL=postgres://ubermart_owner:CAMBIAR@db:5432/ubermart

APP_MASTER_KEY=
JWT_PRIVATE_KEY=

STORAGE_DIR=/data/storage

# SMS para códigos OTP y alertas SOS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Payphone (recargas automáticas). Déjalo vacío para desactivar.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_NOTIFY_SECRET=

# Clima (recargo por lluvia) - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Motor de rutas propio y geocodificador (opcional, compatible con Nominatim)
OSRM_URL=http://osrm:5000
GEOCODER_URL=

COOKIE_SECURE=true
LOG_LEVEL=info
