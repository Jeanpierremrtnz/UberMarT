# Variables de docker compose. Copia a infra/.env (no se sube al repositorio).
API_DOMAIN=api.tudominio.ec
ACME_EMAIL=tu-correo@dominio.com

# Contraseñas de base de datos (genera con: cd backend && npm run gen:secrets)
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# IP o rangos que pueden abrir el panel (separados por espacio).
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0
