# Variables de la API para docker compose. Copia a infra/api.env (no se sube).
# DATABASE_URL, STORAGE_DIR y OSRM_URL los define docker-compose.yml.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.tudominio.ec
APP_DEEP_LINK=ubermart://
TRUST_PROXY=1
APP_MASTER_KEY=
JWT_PRIVATE_KEY=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_NOTIFY_SECRET=
OPENWEATHER_API_KEY=
GEOCODER_URL=
COOKIE_SECURE=true
LOG_LEVEL=info
